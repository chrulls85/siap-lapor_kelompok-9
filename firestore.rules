rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = akun yang dokumen users/{uid}-nya berisi role == 'admin'.
    // Role HANYA bisa diubah lewat Firebase Console (atau server), tidak dari aplikasi.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Profil pengguna: hanya pemilik yang boleh membaca/menulis.
    // Peran baru selalu "warga"; pengguna tidak bisa mengubah perannya sendiri.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == 'warga';
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    match /reports/{reportId} {
      // Warga: hanya laporan miliknya. Admin: semua laporan.
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Warga membuat laporan; status awal wajib "menunggu".
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'menunggu'
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 1000
        && request.resource.data.lokasi is string
        && request.resource.data.lokasi.size() > 0
        && request.resource.data.lokasi.size() <= 300
        && request.resource.data.kategori in ['jalan', 'kebersihan', 'laluLintas']
        && request.resource.data.anonim is bool
        && request.resource.data.tanggalKejadian is timestamp;

      // Hanya admin yang boleh mengubah laporan, dan hanya field status/catatan.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'catatan', 'updatedAt', 'handledBy'])
        && request.resource.data.status in ['menunggu', 'diproses', 'selesai']
        && request.resource.data.catatan is string
        && request.resource.data.catatan.size() <= 200;
    }
  }
}
